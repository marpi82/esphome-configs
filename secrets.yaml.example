# Copy this file to secrets.yaml and fill in your values.
# secrets.yaml is excluded from version control via .gitignore.

# WiFi credentials
wifi_ssid: "MyHomeNetwork"
wifi_password: "MySecretPassword"
wifi_ssid_fallback: "ESPHome-Fallback"
wifi_password_fallback: "fallback123"

# OTA (Over-The-Air update) password
ota_password: "my_ota_password"

# API encryption key (generate with: esphome generate-api-key)
api_encryption_key: "base64_encoded_32_byte_key_here="

# MQTT (optional)
mqtt_broker: "192.168.1.10"
mqtt_username: "mqtt_user"
mqtt_password: "mqtt_password"

# Home Assistant
ha_token: "your_long_lived_access_token"

# Device-specific credentials (add as needed)
# device_username: "admin"
# device_password: "secret"
